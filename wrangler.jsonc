{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentor-api-lab",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
